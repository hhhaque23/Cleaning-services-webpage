# Spectre Cleaning — environment variables.
# Copy to .env.local for local dev, or set these on Railway for production.
# Every var is optional: the site runs without them (with reduced functionality).

# --- Database (Railway Postgres) ---
# When set, bookings + settings persist. When unset, they live in memory and
# reset on every deploy/restart (fine for a quick preview, not for real use).
DATABASE_URL=

# --- Admin / Operations console ---
# Password for /admin (must be >= 4 chars). If unset in production, the admin
# console is disabled (fail-closed). In local dev, unset = demo mode (any password).
ADMIN_PASSWORD=

# --- Public site URL (no trailing slash) ---
# Drives canonical URLs, robots, and sitemap. Set to your real domain or Railway URL.
NEXT_PUBLIC_SITE_URL=https://spectrecleaningsolutions.com

# --- Booking confirmation emails (Resend) ---
# When unset, confirmation emails are skipped and bookings still work normally.
# Setup: create a free account at https://resend.com, verify your sending domain,
# then set both of these. EMAIL_FROM must be an address on the verified domain.
# (Before the domain is verified you can test by setting
#  EMAIL_FROM="Spectre Cleaning <onboarding@resend.dev>" and booking with your
#  own Resend account email.)
RESEND_API_KEY=
EMAIL_FROM="Spectre Cleaning <bookings@spectrecleaningsolutions.com>"

# --- Business timezone (optional) ---
# Used for "today"/calendar date math. Defaults to America/Detroit.
BUSINESS_TZ=America/Detroit
